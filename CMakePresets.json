{
  "version": 3,
  "configurePresets": [
    {
      "name": "dos",
      "displayName": "DJGPP DOS (SDL3)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-dos",
      "toolchainFile": "${sourceDir}/cmake/djgpp.cmake",
      "cacheVariables": {
        "PLATFORM": "dos",
        "BACKEND": "sdl3",
        "AUDIO_BACKEND": "none",
        "VIDEO_BACKEND": "none",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "PLATFORM": "cli",
        "BACKEND": "glfw3",
        "ENABLE_ASAN": false,
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "Debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "RelWithDebInfo",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    }
  ]
}
