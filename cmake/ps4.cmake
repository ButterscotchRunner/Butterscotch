# OpenOrbis PS4 toolchain file

if(NOT DEFINED ENV{OO_PS4_TOOLCHAIN})
    message(FATAL_ERROR "Set OO_PS4_TOOLCHAIN to the OpenOrbis PS4 toolchain directory")
endif()

file(TO_CMAKE_PATH "$ENV{OO_PS4_TOOLCHAIN}" OPENORBIS)
if(NOT EXISTS "${OPENORBIS}/lib/crt1.o" OR NOT EXISTS "${OPENORBIS}/link.x")
    message(FATAL_ERROR "OO_PS4_TOOLCHAIN must contain lib/crt1.o and link.x")
endif()

set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_VERSION 12)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(PS4 TRUE)

set(OPENORBIS_TOOL_HINTS "${OPENORBIS}/bin")
if(DEFINED ENV{PS4_TOOLCHAIN_BIN})
    file(TO_CMAKE_PATH "$ENV{PS4_TOOLCHAIN_BIN}" OPENORBIS_LLVM)
    list(PREPEND OPENORBIS_TOOL_HINTS "${OPENORBIS_LLVM}/bin" "${OPENORBIS_LLVM}")
endif()
find_program(CMAKE_C_COMPILER NAMES clang HINTS ${OPENORBIS_TOOL_HINTS} REQUIRED)
find_program(CMAKE_CXX_COMPILER NAMES clang++ HINTS ${OPENORBIS_TOOL_HINTS} REQUIRED)
find_program(CMAKE_LINKER NAMES ld.lld HINTS ${OPENORBIS_TOOL_HINTS} REQUIRED)
find_program(CMAKE_AR NAMES llvm-ar HINTS ${OPENORBIS_TOOL_HINTS} REQUIRED)
find_program(CMAKE_RANLIB NAMES llvm-ranlib HINTS ${OPENORBIS_TOOL_HINTS} REQUIRED)

set(CMAKE_C_COMPILER_TARGET x86_64-pc-freebsd12-elf)
set(CMAKE_CXX_COMPILER_TARGET x86_64-pc-freebsd12-elf)
set(CMAKE_SYSROOT "${OPENORBIS}")
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
set(OPENORBIS_FLAGS "-D__PS4__ -D__OPENORBIS__ -D__ORBIS__ -funwind-tables -isystem \"${OPENORBIS}/include\" -I\"${OPENORBIS}/usr/include\"")
set(CMAKE_C_FLAGS_INIT "${OPENORBIS_FLAGS}")
set(CMAKE_CXX_FLAGS_INIT "${OPENORBIS_FLAGS} -I\"${OPENORBIS}/include/c++/v1\"")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-m elf_x86_64 -pie --eh-frame-hdr --script \"${OPENORBIS}/link.x\" \"${OPENORBIS}/lib/crt1.o\" -L\"${OPENORBIS}/lib\" -L\"${OPENORBIS}/usr/lib\"")
set(CMAKE_C_STANDARD_LIBRARIES "-lc -lkernel")
set(CMAKE_CXX_STANDARD_LIBRARIES "-lc++ -lc -lkernel")
set(CMAKE_C_LINK_EXECUTABLE "<CMAKE_LINKER> <CMAKE_C_LINK_FLAGS> <LINK_FLAGS> <OBJECTS> -o <TARGET> <LINK_LIBRARIES>")
set(CMAKE_CXX_LINK_EXECUTABLE "<CMAKE_LINKER> <CMAKE_CXX_LINK_FLAGS> <LINK_FLAGS> <OBJECTS> -o <TARGET> <LINK_LIBRARIES>")

set(CMAKE_FIND_ROOT_PATH "${OPENORBIS}" "${OPENORBIS}/usr")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
